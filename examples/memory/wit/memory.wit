package arcjet:memory;

interface host {
  enum color {
    red,
    green,
    blue,
  }

  // 17 flattened values, one more than the canonical ABI passes directly, so
  // every call below moves this record through guest memory. The f32 sits
  // after the string so a store wider than 4 bytes overwrites the string's
  // allocation.
  record everything {
    a-u8: u8,
    a-s8: s8,
    a-u16: u16,
    a-s16: s16,
    a-u32: u32,
    a-s32: s32,
    a-u64: u64,
    a-s64: s64,
    a-f64: f64,
    a-bool: bool,
    a-char: char,
    a-color: color,
    a-opt: option<u8>,
    a-str: string,
    a-f32: f32,
  }

  // 4-byte aligned and 68 bytes long, so its indirect parameter area does
  // not end on an 8-byte boundary. The string's buffer is allocated directly
  // after the area, so writing more than 4 bytes for the trailing f32
  // corrupts the allocator's header for that buffer.
  record narrow {
    n0: u32,
    n1: u32,
    n2: u32,
    n3: u32,
    n4: u32,
    n5: u32,
    n6: u32,
    n7: u32,
    n8: u32,
    n9: u32,
    n10: u32,
    n11: u32,
    n12: u32,
    n13: u32,
    s: string,
    f: f32,
  }

  echo: func(x: everything) -> everything;
}

world memory {
  import host;
  use host.{everything, narrow};

  // The guest returns its argument: the host stores the record into the
  // indirect parameter area and loads the result.
  export round-trip: func(x: everything) -> everything;

  // The guest passes its argument to the host's echo and returns the reply:
  // the host loads the import's parameter and stores its result.
  export call-host-echo: func(x: everything) -> everything;

  // The guest returns its argument, which the host passed in an area whose
  // size is not a multiple of 8.
  export round-trip-narrow: func(x: narrow) -> narrow;
}
