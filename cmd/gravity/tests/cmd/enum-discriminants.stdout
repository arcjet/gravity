		value4, ok4 := i.module.Memory().ReadByte(uint32(results2 + 1))
		// The return type doesn't contain an error so we panic if one is encountered
		if !ok4 {
			panic(errors.New("failed to read byte from memory"))
		}
		var enum5 Level
		switch value4 {
		case 0:
			enum5 = Trace
		case 1:
			enum5 = Debug
		case 2:
			enum5 = Info
		case 3:
			enum5 = Warn
		case 4:
			enum5 = Fatal
		default:
			// The return type doesn't contain an error so we panic if one is encountered
			panic(errors.New("invalid level discriminant"))
		}
		someValue6 := enum5
		result6 = &someValue6
	}
	return result6
}

