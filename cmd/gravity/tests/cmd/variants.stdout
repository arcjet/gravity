						variantPayload := case4.Value
						i.module.Memory().WriteByte(base+0, uint8(4))
						memory3 := i.module.Memory()
						realloc3 := i.exports.get("cabi_realloc")
						ptr3, len3, err3 := writeString(ctx, variantPayload, memory3, realloc3)
						if err3 != nil {
							var default3 string
							return default3, err3
						}
						i.module.Memory().WriteUint32Le(base+8, uint32(len3))
						i.module.Memory().WriteUint32Le(base+4, uint32(ptr3))
					default:
						var default4 string
						return default4, errors.New("invalid variant type provided")
				}
			}
			variant6_0 = 1
			variant6_1 = ptr5
			variant6_2 = len5
		default:
			var default6 string
			return default6, errors.New("invalid variant type provided")
	}
	raw7, err7 := i.exports.get("choose-many").Call(ctx, uint64(variant6_0), uint64(variant6_1), uint64(variant6_2))
	if err7 != nil {
		var default7 string
		return default7, err7
	}

	// The cleanup via `cabi_post_*` cleans up the memory in the guest. By
	// deferring this, we ensure that no memory is corrupted before the function
	// is done accessing it.
	defer func() {
		if postFn := i.exports.get("cabi_post_choose-many"); postFn != nil {
			if _, err := postFn.Call(ctx, raw7...); err != nil {
				gravity_err = errors.Join(gravity_err, fmt.Errorf("failed to clean up after choose-many: %w", err))
			}
		}
	}()

	results7 := raw7[0]
	ptr8, ok8 := i.module.Memory().ReadUint32Le(uint32(results7 + 0))
	if !ok8 {
		var default8 string
		return default8, errors.New("failed to read pointer from memory")
	}
	len9, ok9 := i.module.Memory().ReadUint32Le(uint32(results7 + 4))
	if !ok9 {
		var default9 string
		return default9, errors.New("failed to read length from memory")
	}
	buf10, ok10 := i.module.Memory().Read(ptr8, len9)
	if !ok10 {
		var default10 string
		return default10, errors.New("failed to read bytes from memory")
	}
	if !utf8.Valid(buf10) {
		var default10 string
		return default10, errors.New("invalid UTF-8 in string received from the guest")
	}
	str10 := string(buf10)
	return str10, nil
}

